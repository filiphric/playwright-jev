{
  "name": "playwright-jev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A typed Jev browser agent over Playwright CLI, with a recorded Playwright MCP comparison.",
  "scripts": {
    "setup": "npm ci --prefix demo && npm run demo:build",
    "demo:build": "vite build --config config/demo.vite.ts",
    "demo": "tsx lib/demo/server.ts",
    "jev": "tsx lib/agent/cli.ts",
    "compare": "tsx lib/comparison/cli.ts",
    "render": "tsx lib/comparison/render.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "@playwright/cli": "0.1.21",
    "@playwright/mcp": "0.0.82",
    "pino": "^10.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0-alpha-1789764292000",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.1"
  },
  "engines": {
    "node": ">=22"
  }
}
